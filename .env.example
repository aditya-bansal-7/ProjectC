# Telegram Bot Token for Project C
BOT_TOKEN=

# MongoDB connection URI
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net

# MongoDB database name
MONGO_DB=projectc

# Project B base URL (running Node.js service)
PROJECT_B_URL=http://localhost:3000

# Project B API Secret (Bearer token for /retweet endpoint)
PROJECT_B_SECRET=

# Comma-separated Telegram user IDs of super-admins (seed admins)
ADMIN_IDS=
